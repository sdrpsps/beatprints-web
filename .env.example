# API 服务监听的端口。
# Port on which the API server listens.
PORT=8000

# 生产环境建议设置为一段足够长的随机字符串。留空表示不鉴权。
# In production, use a sufficiently long random string. Leave blank to disable authentication.
API_KEY=

# 多个前端域名使用逗号分隔；没有浏览器前端时可留空。
# Separate frontend origins with commas; leave blank if there is no browser frontend.
CORS_ORIGINS=

# 可选：Spotify 应用的客户端 ID 和密钥，用于启用搜索与元数据获取。
# Optional: Spotify app client ID and secret for search and metadata; create an app in the Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Spotify 目录的市场地区，使用两位国家或地区代码。
# Spotify catalog market, using a two-letter country or region code.
SPOTIFY_MARKET=US

# Apple 音乐目录的地区；通过 iTunes Search API 的 country 参数指定。
# Apple music catalog region, passed as the iTunes Search API country parameter.
APPLE_MUSIC_STOREFRONT=US

# 微信二维码服务地址；Compose 自动配置，非 Compose 部署需手动填写。
# WeChat QR code service URL; configured automatically by Compose, set manually for other deployments.
# WECHAT_QR_BASE_URL=http://127.0.0.1:8080

# 元数据缓存的最大条目数；可减少对音乐平台的重复请求。
# Maximum number of metadata cache entries; reduces repeated requests to music services.
METADATA_CACHE_MAX_ENTRIES=256

# 元数据缓存的有效时间，单位为秒。
# Metadata cache lifetime in seconds.
METADATA_CACHE_TTL_SECONDS=600

# API 工作进程数；生成 2280x3480 图片消耗较多内存，1 GB 服务器建议保持为 1。
# Number of API worker processes; generating 2280x3480 images uses significant memory, so 1 is recommended on a 1 GB server.
WEB_CONCURRENCY=1

# 每个工作进程可同时执行的海报生成任务数；1 GB 服务器建议保持为 1。
# Maximum concurrent poster generation jobs per worker; 1 is recommended on a 1 GB server.
MAX_CONCURRENT_JOBS=1
