PORT=8000

# 生产环境建议设置为一段足够长的随机字符串。留空表示不鉴权。
API_KEY=

# 多个前端域名使用逗号分隔；没有浏览器前端时可留空。
CORS_ORIGINS=

# 可选：启用 Spotify 搜索。需要在 Spotify Developer Dashboard 创建应用。
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
APPLE_MUSIC_STOREFRONT=US

# 元数据缓存可避免歌词预览与海报生成重复请求音乐平台。
METADATA_CACHE_MAX_ENTRIES=256
METADATA_CACHE_TTL_SECONDS=600

# 生成 2280x3480 图片消耗较多内存。1 GB 服务器建议都保持为 1。
WEB_CONCURRENCY=1
MAX_CONCURRENT_JOBS=1
